# NELA Cloud endpoints (desktop client only — no provider secrets here)
# API runs on :3001; website (login/account) on :3000
# See nela-backend/.env.example and NELA-Webpage/.env.example
#
# Local smoke: start API with `npm run dev` in nela-backend,
# then launch the desktop with these defaults. See CLOUD.md.
NELA_CLOUD_API_BASE_URL=http://localhost:3001
NELA_CLOUD_WEB_BASE_URL=http://localhost:3000

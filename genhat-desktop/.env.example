# # NELA Cloud endpoints (desktop client only — no provider secrets here)
# #
# # Defaults (no .env needed for production):
# #   API  https://nela-gateway.onrender.com
# #   Web  https://nela-webpage.vercel.app
# # If production is unreachable, the app falls back to localhost.
# #
# # Local development override (optional):
# NELA_CLOUD_API_BASE_URL=http://localhost:3001
# NELA_CLOUD_WEB_BASE_URL=http://localhost:3000
